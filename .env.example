# DRAVYADEX 1.0 — Environment Configuration
# When connecting to a hosted Supabase project, populate these variables.
# When omitted, DravyaDex seamlessly falls back to local high-fidelity seed datasets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Analytics & Deployment Knobs
NEXT_PUBLIC_APP_URL=http://localhost:3000
